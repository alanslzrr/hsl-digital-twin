      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-flota"
          },
          "query": "datos = from(bucket: \"flota\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"error_eta\" and r.metodo == \"v2\" and r.version == \"piloto-1\" and (r._field == \"error_modelo\" or r._field == \"error_base\"))\n  |> group(columns: [\"horizonte\", \"marcha\", \"_field\"])\n  |> mean()\n  |> group(columns: [\"horizonte\", \"marcha\"])\n  |> pivot(rowKey: [\"horizonte\", \"marcha\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nn = from(bucket: \"flota\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"error_eta\" and r.metodo == \"v2\" and r.version == \"piloto-1\" and r._field == \"y_s\")\n  |> group(columns: [\"horizonte\", \"marcha\"])\n  |> count()\n  |> rename(columns: {_value: \"n\"})\n  |> keep(columns: [\"horizonte\", \"marcha\", \"n\"])\njoin(tables: {d: datos, c: n}, on: [\"horizonte\", \"marcha\"])\n  |> group()\n  |> map(fn: (r) => ({\n      horizonte: if r.horizonte == \"lt30\" then \"< 30 s\" else if r.horizonte == \"30a60\" then \"30-60 s\" else \"> 60 s\",\n      marcha: if r.marcha == \"parado\" then \"parado\" else \"en marcha\",\n      n: r.n,\n      mae_base_s: r.error_base,\n      mae_modelo_s: r.error_modelo\n  }))\n  |> keep(columns: [\"horizonte\", \"marcha\", \"n\", \"mae_base_s\", \"mae_modelo_s\"])\n",
